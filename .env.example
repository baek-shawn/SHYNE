# SHYNE 환경 변수 예시
#
# 이 파일을 복사해 저장소 루트에 .env를 만들고 값을 채운다. .env는 절대 커밋하지 않는다.
# backend/agent/runtime.py의 build_runtime()이 이 값을 읽는다. 이미 설정된 실제 환경 변수가
# .env보다 우선한다.

# openai | vllm  (둘 다 OpenAI-compatible API로 호출한다. Ollama/LM Studio는 vllm으로 지정)
# anthropic은 Step 3에서 구현 예정, none이면 CLI가 설정 안내만 출력하고 종료한다.
LLM_PROVIDER=none

# OpenAI-compatible 엔드포인트 (vLLM/Ollama/LM Studio/OpenAI 공통)
# OpenAI를 쓸 때: LLM_BASE_URL=https://api.openai.com/v1 (openai면 비워둬도 이 값이 기본)
# vLLM은 서버를 --enable-auto-tool-choice --tool-call-parser <parser> 옵션으로 띄워야 한다.
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=EMPTY
LLM_MODEL=

# 선택: 지정하면 요청에 temperature를 넣는다. 비워두면 서버 기본값을 쓴다.
# (일부 OpenAI 모델은 기본값 이외의 temperature를 거부하므로 기본은 비워둔다.)
LLM_TEMPERATURE=

# Agent Loop 안전장치 (Step 1 기본값)
AGENT_MAX_ITERATIONS=20
AGENT_COMMAND_TIMEOUT=60
AGENT_MAX_CONSECUTIVE_ERRORS=3

# 개발 편의용: true면 CONFIRM 등급 Tool도 자동 승인 (Step 4 참고, 아직 읽는 코드 없음)
AGENT_DEV_MODE_AUTO_APPROVE=false
