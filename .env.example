# SHYNE 환경 변수 예시 (placeholder)
#
# Step 3(LLM Provider 분리)에서 실제 코드가 이 값을 읽기 시작한다. 지금은 형식만 정의해둔다.
# 이 파일을 복사해 .env를 만들고, .env는 절대 커밋하지 않는다.

# openai | vllm | anthropic | none(코드 없이 구조만 확인할 때)
LLM_PROVIDER=none

# OpenAI-compatible 엔드포인트 (vLLM/Ollama/LM Studio/OpenAI 공통)
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=EMPTY
LLM_MODEL=

# Agent Loop 안전장치 (Step 1 기본값)
AGENT_MAX_ITERATIONS=20
AGENT_COMMAND_TIMEOUT=60
AGENT_MAX_CONSECUTIVE_ERRORS=3

# 개발 편의용: true면 CONFIRM 등급 Tool도 자동 승인 (Step 4 참고, 운영에서는 사용 금지)
AGENT_DEV_MODE_AUTO_APPROVE=false
